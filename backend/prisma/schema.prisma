// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id               Int        @id @default(autoincrement())
  roleId           Int
  firstName        String     @db.VarChar(100)
  lastName         String     @db.VarChar(100)
  email            String     @unique @db.VarChar(150)
  password         String
  phone            String?    @db.VarChar(20)
  avatar           String?
  status           UserStatus @default(ACTIVE)
  resetToken       String?    @db.VarChar(255)
  resetTokenExpiry DateTime?
  role       Role       @relation(fields: [roleId], references: [id])
  reviews    Review[]
  wishlists  Wishlist[]
  bookings   Booking[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([roleId])
}

model Country {
  id           Int           @id @default(autoincrement())
  name         String        @unique @db.VarChar(100)
  code         String        @unique @db.VarChar(5)
  cities       City[]
  destinations Destination[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model City {
  id           Int           @id @default(autoincrement())
  countryId    Int
  name         String        @db.VarChar(100)
  country      Country       @relation(fields: [countryId], references: [id])
  destinations Destination[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([countryId])
  @@unique([countryId, name])
}

model Category {
  id           Int           @id @default(autoincrement())
  name         String        @unique @db.VarChar(100)
  slug         String        @unique @db.VarChar(150)
  destinations Destination[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Destination {
  id                 Int                  @id @default(autoincrement())
  categoryId         Int
  countryId          Int
  cityId             Int
  title              String               @db.VarChar(200)
  slug               String               @unique @db.VarChar(200)
  shortDescription   String               @db.VarChar(500)
  description        String               @db.LongText
  thumbnail          String? @db.VarChar(255)
  heroImage          String? @db.VarChar(255)
  price              Decimal              @db.Decimal(10,2)
  duration           String               @db.VarChar(50)
  rating             Decimal              @default(5.0) @db.Decimal(2,1)
  featured           Boolean              @default(false)
  maxGuests          Int                  @default(2)
  cancellationPolicy String?              @db.LongText
  checkIn            String?              @db.VarChar(20)
  checkOut           String?              @db.VarChar(20)
  metaTitle          String?              @db.VarChar(255)
  metaDescription    String?              @db.VarChar(500)
  displayOrder       Int                  @default(0)
  isPublished        Boolean              @default(true)

  category           Category             @relation(fields: [categoryId], references: [id])
  country            Country              @relation(fields: [countryId], references: [id])
  city               City                 @relation(fields: [cityId], references: [id])

  images             DestinationImage[]
  itineraries        Itinerary[]
  amenities          DestinationAmenity[]
  reviews            Review[]
  wishlists          Wishlist[]
  bookings           Booking[]
  highlights         DestinationHighlight[]
  blockedDates       DestinationBlockedDate[]

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([categoryId])
  @@index([countryId])
  @@index([cityId])
  @@index([featured])
  @@index([isPublished])
  @@index([displayOrder])
}

model DestinationImage {
  id            Int         @id @default(autoincrement())
  destinationId Int
  image         String
  sortOrder     Int         @default(0)
  destination   Destination @relation(fields: [destinationId], references: [id])

  @@index([destinationId])
}

model Amenity {
  id           Int                    @id @default(autoincrement())
  name         String                 @unique
  destinations DestinationAmenity[]
}

model DestinationAmenity {
  destinationId Int
  amenityId     Int
  destination   Destination @relation(fields: [destinationId], references: [id])
  amenity       Amenity     @relation(fields: [amenityId], references: [id])

  @@id([destinationId, amenityId])
}

model Itinerary {
  id            Int         @id @default(autoincrement())
  destinationId Int
  day           Int
  title         String
  description   String      @db.LongText
  destination   Destination @relation(fields: [destinationId], references: [id])

  @@index([destinationId])
}
model DestinationHighlight {
  id            Int         @id @default(autoincrement())
  destinationId Int
  title         String      @db.VarChar(255)

  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([destinationId])
}

model Review {
  id            Int         @id @default(autoincrement())
  destinationId Int
  userId        Int
  bookingId     Int?        @unique
  rating        Decimal     @db.Decimal(2,1)
  review        String      @db.LongText
  isHidden      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  destination   Destination @relation(fields: [destinationId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
  booking       Booking?    @relation(fields: [bookingId], references: [id])
  @@index([destinationId])
  @@index([userId])
}

model Wishlist {
  userId        Int
  destinationId Int
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id])
  destination   Destination @relation(fields: [destinationId], references: [id])

  @@id([userId, destinationId])
}

model Setting {
  id    Int     @id @default(autoincrement())
  key   String  @unique
  value String? @db.LongText
  group String  @default("general")

  @@index([group])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Booking {
  id            Int           @id @default(autoincrement())
  userId        Int
  destinationId Int
  travelDate    DateTime
  guests        Int
  totalAmount   Decimal       @db.Decimal(10,2)
  status        BookingStatus @default(PENDING)
  contactFirstName String?    @db.VarChar(100)
  contactLastName  String?    @db.VarChar(100)
  contactPhone     String?    @db.VarChar(20)

  user          User          @relation(fields: [userId], references: [id])
  destination   Destination   @relation(fields: [destinationId], references: [id])
  payment       Payment?
  review        Review?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([destinationId])
}

enum ContactMessageStatus {
  NEW
  READ
  RESPONDED
}

model ContactMessage {
  id          Int                   @id @default(autoincrement())
  name        String                @db.VarChar(150)
  email       String                @db.VarChar(150)
  phone       String?               @db.VarChar(20)
  destination String?               @db.VarChar(150)
  travelDate  DateTime?
  guests      Int?
  budget      String?               @db.VarChar(50)
  subject     String?               @db.VarChar(200)
  message     String                @db.LongText
  status      ContactMessageStatus  @default(NEW)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([status])
}

enum EmailLogStatus {
  SENT
  FAILED
}

model EmailLog {
  id           Int             @id @default(autoincrement())
  toEmail      String          @db.VarChar(150)
  subject      String          @db.VarChar(255)
  type         String          @db.VarChar(50)
  status       EmailLogStatus
  errorMessage String?         @db.LongText
  createdAt    DateTime        @default(now())

  @@index([status])
  @@index([type])
}

model DestinationBlockedDate {
  id            Int         @id @default(autoincrement())
  destinationId Int
  date          DateTime    @db.Date
  reason        String?     @db.VarChar(200)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, date])
  @@index([destinationId])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id                    Int           @id @default(autoincrement())
  bookingId             Int           @unique
  amount                Decimal       @db.Decimal(10,2)
  method                String
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @db.VarChar(255)
  failureReason         String?       @db.VarChar(500)
  booking               Booking       @relation(fields: [bookingId], references: [id])
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @default(now()) @updatedAt
}

model Post {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  excerpt     String   @db.Text
  content     String   @db.LongText
  image       String?
  category    String
  readTime    String
  isPublished Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
}